{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/vista-oferta.js": { "includeFiles": "dist/index.html" }
  },
  "headers": [
    {
      "source": "/:ruta(acceso|espacio|revision|portafolio|administracion|cuenta)/:resto*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/evidencia-stellar/casa-prado", "destination": "/evidencia-stellar/casa-prado.html" },
    { "source": "/ofertas/:id", "destination": "/api/vista-oferta?id=:id" },
    { "source": "/planes", "destination": "/api/vista-oferta?pagina=planes" },
    { "source": "/api/:path((?!vista-oferta$).*)", "destination": "https://gateway-production-b9371022.up.railway.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
