{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "usuarios": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Usuarios/{**resto}" }
      },
      "subscripciones": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Subscripciones/{**resto}" }
      },
      "planes": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Planes/{**resto}" }
      },
      "roles": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Roles/{**resto}" }
      },
      "usuarioRol": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/UsuarioRol/{**resto}" }
      },
      "administradorBorrarBases": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Administrador/BorrarBases/{tenantId}", "Methods": [ "DELETE" ] }
      },
      "archivos": {
        "ClusterId": "archivos",
        "Match": { "Path": "/api/Archivos/{**resto}" }
      },
      "empleados": {
        "ClusterId": "expedientes",
        "Match": { "Path": "/api/Empleados/{**resto}" }
      },
      "empleadoArchivos": {
        "ClusterId": "expedientes",
        "Match": { "Path": "/api/EmpleadoArchivos/{**resto}" }
      },
      "documentacionAdministracion": {
        "ClusterId": "administracion",
        "Match": { "Path": "/openapi/administracion.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "documentacionArchivos": {
        "ClusterId": "archivos",
        "Match": { "Path": "/openapi/archivos.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "documentacionExpedientes": {
        "ClusterId": "expedientes",
        "Match": { "Path": "/openapi/expedientes.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      }
    },
    "Clusters": {
      "administracion": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7266/" }
        }
      },
      "archivos": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7043/" }
        }
      },
      "expedientes": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7173/" }
        }
      }
    }
  }
}
