{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "compras": {
        "ClusterId": "comercio",
        "Match": { "Path": "/api/Compras/{**resto}" }
      },
      "ofertas": {
        "ClusterId": "comercio",
        "Match": { "Path": "/api/Ofertas/{**resto}" }
      },
      "sesionDemo": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/SesionDemo/{**resto}" }
      },
      "usuarios": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Usuarios/{**resto}" }
      },
      "subscripciones": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Subscripciones/{**resto}" }
      },
      "planes": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Planes/{**resto}" }
      },
      "roles": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Roles/{**resto}" }
      },
      "usuarioRol": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/UsuarioRol/{**resto}" }
      },
      "administradorBorrarBases": {
        "ClusterId": "administracion",
        "Match": { "Path": "/api/Administrador/BorrarBases/{tenantId}", "Methods": [ "DELETE" ] }
      },

      "tokenizacion": {
        "ClusterId": "tokenizacion",
        "Match": { "Path": "/api/Tokenizacion/{**resto}" }
      },
      "documentacionAdministracion": {
        "ClusterId": "administracion",
        "Match": { "Path": "/openapi/administracion.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },

      "inmuebles": {
        "ClusterId": "inmuebles",
        "Match": { "Path": "/api/Inmuebles/{**resto}" }
      },
      "documentacionInmuebles": {
        "ClusterId": "inmuebles",
        "Match": { "Path": "/openapi/inmuebles.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "documentacionTokenizacion": {
        "ClusterId": "tokenizacion",
        "Match": { "Path": "/openapi/tokenizacion.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      }
    },
    "Clusters": {
      "comercio": {
        "Destinations": { "principal": { "Address": "https://localhost:7313/" } }
      },
      "administracion": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7266/" }
        }
      },

      "inmuebles": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7311/" }
        }
      },
      "tokenizacion": {
        "Destinations": {
          "principal": { "Address": "https://localhost:7314/" }
        }
      }
    }
  }
}
