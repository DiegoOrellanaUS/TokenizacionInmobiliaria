        <mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="446" y="480" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="818" y="665" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="650" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1475" y="1165" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1310" y="392" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2265" y="300" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2340" y="30" width="650" height="1540" as="geometry" /></mxCell>
        <mxCell id="legend-container" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="2360" y="60" width="602" height="1480" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="0" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Frontends e identidad&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Los usuarios entran a una de las tres apps Next.js en Amplify Hosting (con WAF) e inician sesión en Amazon Cognito, que aplica MFA y entrega el JWT.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="105" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;API y servicios&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;El navegador llama a API Gateway REST (con WAF) con el JWT. El autorizador de Cognito valida el token e invoca la función Lambda .NET del servicio según la ruta.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="210" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Datos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Los servicios usan RDS PostgreSQL a través de RDS Proxy con autenticación IAM, un esquema por servicio. Reportes guarda sus modelos de lectura en DynamoDB y los exporta a S3 para consultas ad hoc con Athena. Los documentos van a S3 (escaneados por GuardDuty) y la idempotencia a otra tabla DynamoDB.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="315" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Saga de compra&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Comercio e Inversión inicia la saga en Step Functions, que reserva el saldo en Caja y Pagos y encola el envío a Stellar en SQS FIFO, un grupo de mensajes por cuenta firmante.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="420" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Tokenization y Stellar&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Tokenization, sin ruta pública, consume la cola FIFO, firma con llaves Ed25519 de KMS y envía la transacción a Stellar Horizon por el NAT Gateway.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="525" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Eventos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Cada servicio publica sus eventos con el patrón outbox en EventBridge, que los reparte a colas SQS con DLQ. EventBridge Scheduler dispara cierres, conciliaciones y la lectura de Horizon cada minuto.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="630" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Webhooks&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Pollar y el proveedor de KYC llaman a una REST API separada con su propio WAF. Una función verifica la firma y escribe el evento en SQS para el servicio dueño.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container" connectable="0"><mxGeometry x="0" y="735" width="600" height="95" as="geometry" /></mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;AI Concierge&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;El inversionista conversa con el agente en AgentCore Runtime, que guarda el contexto en AgentCore Memory y usa AgentCore Gateway para llamar a rutas de solo lectura de la API con el token del propio usuario.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="95" as="geometry" /></mxCell>
        <mxCell id="legend-aux-note" value="&lt;i&gt;CloudWatch, X-Ray y CloudTrail son servicios auxiliares: registran logs, trazas, métricas y cada firma de KMS de todos los componentes.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#333333,#E0E0E0);" vertex="1" parent="legend-container"><mxGeometry x="0" y="850" width="600" height="50" as="geometry" /></mxCell>
        <mxCell id="legend-line-note" value="&lt;i&gt;Líneas punteadas: S3 envía cada archivo subido a GuardDuty Malware Protection, y las exportaciones de DynamoDB a S3 alimentan a Athena. Las flechas que entran o salen del recuadro de servicios de dominio aplican a todas sus funciones.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#333333,#E0E0E0);" vertex="1" parent="legend-container"><mxGeometry x="0" y="910" width="600" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
